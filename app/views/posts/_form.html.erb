<%= form_with(model: post, class: "contents") do |form| %>
  <div class="w-screen h-screen bg-black flex items-center justify-center overflow-hidden font-sans text-white md:p-28">
    <div class="w-full h-full md:h-auto md:aspect-[16/10] md:max-w-7xl bg-[#1c1c1e] shadow-2xl md:rounded-[3rem] overflow-hidden flex flex-col md:flex-row relative border-gray-800 md:border">
      
      <div class="w-full h-[40%] md:h-full md:w-1/2 bg-[#5c5c5d] flex items-center justify-center p-6 md:p-12 shrink-0 border-b md:border-b-0 md:border-r border-gray-800">
        <div class="relative max-w-full max-h-full flex items-center justify-center shadow-2xl">
          <img id="image-preview" src="" class="hidden max-w-full max-h-[70vh] object-contain transition-all duration-300" />
          
          <div class="absolute inset-0 flex items-center justify-center pointer-events-none p-4">
            <p id="overlay-preview" class="text-white text-base md:text-2xl font-black text-center break-words max-w-[95%] transition-all duration-300 leading-tight"></p>
          </div>
          
          <div id="placeholder" class="text-gray-500 flex flex-col items-center">
            <p class="text-[10px] uppercase tracking-widest text-[#c5c5c5] font-bold">Aperçu du média</p>
          </div>
        </div>
      </div>

      <div class="flex-1 flex flex-col h-full bg-[#1c1c1e] relative overflow-hidden">
        <div class="flex-1 flex flex-col p-6 md:p-12 min-h-0 overflow-y-auto pb-24">
          <div class="flex justify-between items-center mb-4">
            <h1 class="text-3xl font-black text-indigo-500 tracking-tight">Cliking Editor</h1>
            <span id="char-count" class="text-[10px] font-mono text-indigo-400">0 / 300</span>
          </div>
          <%= form.text_area :caption, id: "input-text", maxlength: "300", placeholder: "Votre message...", 
              class: "w-full h-[200px] bg-transparent border-none focus:ring-0 text-base md:text-base placeholder-gray-600 text-gray-300 p-0 resize-none transition-colors" %>
        </div>

        <div id="control-panel" style="transform: translateY(88%);" class="absolute bottom-0 left-0 w-full h-full bg-[#2c2c2e] rounded-t-[3rem] md:rounded-none shadow-[0_-20px_50px_rgba(0,0,0,0.8)] transition-transform duration-500 ease-in-out z-50">
          <button type="button" onclick="togglePanel()" class="w-full flex flex-col items-center py-5 group cursor-pointer active:bg-white/5 relative z-50">
            <div id="panel-handle" class="w-12 h-1.5 bg-gray-700 group-hover:bg-indigo-500 rounded-full transition-all duration-300"></div>
          </button>

          <div id="panel-content" class="px-8 pb-32 space-y-8 overflow-y-auto h-full">
            <div>
              <p class="text-[10px] uppercase tracking-widest text-gray-500 mb-4 font-bold">Filtres</p>
              <div class="flex gap-4 overflow-x-auto pb-2 scrollbar-hide">
                <button type="button" onclick="setFilterType(this, 'none')" class="filter-btn shrink-0 p-0.5 border-2 border-indigo-500 rounded-2xl">
                  <div class="w-14 h-14 bg-gray-800 rounded-xl flex items-center justify-center font-bold text-indigo-400 text-[9px]">|||</div>
                  <span class="text-[9px] block mt-1 text-center font-bold text-indigo-400">Normal</span>
                </button>
                <button type="button" onclick="setFilterType(this, 'grayscale')" class="filter-btn shrink-0 p-0.5 border-2 border-transparent rounded-2xl">
                  <div class="w-14 h-14 bg-gray-800 grayscale rounded-xl"></div>
                  <span class="text-[9px] block mt-1 text-center text-gray-500">N&B</span>
                </button>
                <button type="button" onclick="setFilterType(this, 'sepia')" class="filter-btn shrink-0 p-0.5 border-2 border-transparent rounded-2xl">
                  <div class="w-14 h-14 bg-orange-900/20 sepia rounded-xl"></div>
                  <span class="text-[9px] block mt-1 text-center text-gray-500">Sépia</span>
                </button>
                <button type="button" onclick="setFilterType(this, 'froid')" class="filter-btn shrink-0 p-0.5 border-2 border-transparent rounded-2xl">
                  <div class="w-14 h-14 bg-blue-900/30 rounded-xl"></div>
                  <span class="text-[9px] block mt-1 text-center text-gray-500">Froid</span>
                </button>
                <button type="button" onclick="setFilterType(this, 'chaud')" class="filter-btn shrink-0 p-0.5 border-2 border-transparent rounded-2xl">
                  <div class="w-14 h-14 bg-yellow-600/20 rounded-xl"></div>
                  <span class="text-[9px] block mt-1 text-center text-gray-500">Chaud</span>
                </button>
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-6">
              <div id="intensity-group" class="space-y-3 opacity-30">
                <div class="flex justify-between text-[10px] text-gray-500 font-bold uppercase"><span>Intensité</span> <span id="txt-intensity" class="text-indigo-400">100%</span></div>
                <input type="range" id="range-intensity" min="0" max="100" value="100" class="w-full accent-indigo-500" oninput="applyAll()" disabled>
              </div>
              <div class="space-y-3">
                <div class="flex justify-between text-[10px] text-gray-500 font-bold uppercase"><span>Luminosité</span> <span id="txt-bright" class="text-indigo-400">100%</span></div>
                <input type="range" id="range-bright" min="0" max="200" value="100" class="w-full accent-indigo-500" oninput="applyAll()">
              </div>
              <div class="space-y-3 md:col-span-2">
                <div class="flex justify-between text-[10px] text-gray-500 font-bold uppercase"><span>Contraste</span> <span id="txt-contrast" class="text-indigo-400">100%</span></div>
                <input type="range" id="range-contrast" min="0" max="200" value="100" class="w-full accent-indigo-500" oninput="applyAll()">
              </div>
            </div>

            <div class="space-y-4">
              <p class="text-[10px] uppercase tracking-widest text-gray-500 font-bold">Style du texte</p>
              <div class="flex flex-wrap gap-3 items-center">
                <button type="button" onclick="setTextStyle(this, 'white')" class="w-10 h-10 flex items-center justify-center bg-white text-black text-xl font-black rounded-xl border-2 border-indigo-500">T</button>
                <button type="button" onclick="setTextStyle(this, 'black')" class="w-10 h-10 flex items-center justify-center bg-black text-white text-xl font-black rounded-xl border-2 border-transparent">T</button>
                <button type="button" onclick="setTextStyle(this, 'indigo-500')" class="w-10 h-10 flex items-center justify-center bg-indigo-500 text-white text-xl font-black rounded-xl border-2 border-transparent">T</button>
                <div class="h-8 w-px bg-gray-700 mx-1"></div>
                <button type="button" onclick="setTextBadge(this, 'none')" class="badge-btn px-3 py-2 bg-gray-800 text-[10px] font-bold rounded-lg border-2 border-indigo-500">SANS</button>
                <button type="button" onclick="setTextBadge(this, 'dark')" class="badge-btn px-3 py-2 bg-black/60 text-[10px] font-bold rounded-lg border-2 border-transparent">SOMBRE</button>
                <button type="button" onclick="setTextBadge(this, 'light')" class="badge-btn px-3 py-2 bg-white/70 text-black text-[10px] font-bold rounded-lg border-2 border-transparent">CLAIR</button>
                <button type="button" onclick="setTextBadge(this, 'blur')" class="badge-btn px-3 py-2 bg-transparent backdrop-blur-xl text-[10px] font-bold rounded-lg border-2 border-transparent ring-1 ring-white/20">FLOU</button>
              </div>

              <input type="hidden" name="post[text_color]" id="hidden-text-color" value="white">
              <input type="hidden" name="post[badge_mode]" id="hidden-badge-mode" value="none">
              <input type="hidden" name="post[filter_type]" id="hidden-filter-type" value="none">
              <input type="hidden" name="post[brightness]" id="hidden-brightness" value="100">
              <input type="hidden" name="post[contrast]" id="hidden-contrast" value="100">
              <input type="hidden" name="post[intensity]" id="hidden-intensity" value="100">
            </div>

            <div class="flex flex-col gap-4 pt-4">
              <label for="main-file-input-final" class="w-full bg-[#1c1c1e] border-2 border-gray-700 py-4 rounded-2xl text-center text-[10px] font-black cursor-pointer text-white uppercase tracking-widest active:bg-gray-800 transition-colors">
                Choisir une photo
                <%= form.file_field :image, id: "main-file-input-final", class: "hidden", accept: "image/*" %>
              </label>
              <%= form.submit "ENREGISTRER", class: "w-full bg-indigo-500 text-white py-4 rounded-2xl text-[10px] font-black cursor-pointer uppercase tracking-widest active:scale-95 transition-all shadow-lg" %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

<script>
  var currentFilterType = 'none';

  window.togglePanel = function() {
    const panel = document.getElementById('control-panel');
    if (panel) {
      panel.style.transform = (panel.style.transform === "translateY(15%)") ? "translateY(88%)" : "translateY(15%)";
    }
  }

  window.applyAll = function() {
    const img = document.getElementById('image-preview');
    if(!img || !img.src || img.src === window.location.href) return;

    const intensity = document.getElementById('range-intensity').value;
    const bright = document.getElementById('range-bright').value;
    const contrast = document.getElementById('range-contrast').value;

    // Mise à jour des champs cachés pour le serveur
    document.getElementById('hidden-brightness').value = bright;
    document.getElementById('hidden-contrast').value = contrast;
    document.getElementById('hidden-intensity').value = intensity;

    let f = '';
    if (currentFilterType === 'grayscale') f = `grayscale(${intensity}%) `;
    else if (currentFilterType === 'sepia') f = `sepia(${intensity}%) `;
    else if (currentFilterType === 'froid') f = `hue-rotate(${intensity * 1.8}deg) saturate(${100 + (intensity/2)}%) `;
    else if (currentFilterType === 'chaud') f = `sepia(${intensity/2}%) saturate(${100 + parseInt(intensity)}%) hue-rotate(${-intensity/3}deg) `;

    img.style.filter = `${f} brightness(${bright}%) contrast(${contrast}%)`;
    
    if(document.getElementById('txt-intensity')) document.getElementById('txt-intensity').innerText = intensity + '%';
    if(document.getElementById('txt-bright')) document.getElementById('txt-bright').innerText = bright + '%';
    if(document.getElementById('txt-contrast')) document.getElementById('txt-contrast').innerText = contrast + '%';
  }

  window.setFilterType = function(btn, type) {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.replace('border-indigo-500', 'border-transparent'));
    btn.classList.replace('border-transparent', 'border-indigo-500');
    
    currentFilterType = type;
    document.getElementById('hidden-filter-type').value = type;

    const iGroup = document.getElementById('intensity-group');
    const iRange = document.getElementById('range-intensity');
    
    if (type === 'none') {
      iRange.value = 100; iGroup.style.opacity = "0.3"; iRange.disabled = true;
    } else {
      iGroup.style.opacity = "1"; iRange.disabled = false;
    }
    applyAll();
  };

  window.setTextStyle = function(btn, color) {
    const overlay = document.getElementById('overlay-preview');
    overlay.classList.remove('text-white', 'text-black', 'text-indigo-500');
    overlay.classList.add('text-' + color);
    document.getElementById('hidden-text-color').value = color;
    btn.parentElement.querySelectorAll('button').forEach(b => b.classList.replace('border-indigo-500', 'border-transparent'));
    btn.classList.replace('border-transparent', 'border-indigo-500');
  }

  window.setTextBadge = function(btn, type) {
    const overlay = document.getElementById('overlay-preview');
    overlay.className = overlay.className.replace(/bg-\S+|backdrop-blur-\S+|px-\S+|py-\S+|rounded-\S+|shadow-\S+|ring-\S+/g, '').trim();
    if (type !== 'none') {
      overlay.classList.add('px-5', 'py-2', 'rounded-2xl');
      if (type === 'dark') overlay.classList.add('bg-black/60', 'backdrop-blur-md');
      if (type === 'light') overlay.classList.add('bg-white/70', 'backdrop-blur-md');
      if (type === 'blur') overlay.classList.add('backdrop-blur-2xl', 'bg-white/5', 'ring-1', 'ring-white/10');
    }
    document.getElementById('hidden-badge-mode').value = type;
    btn.parentElement.querySelectorAll('.badge-btn').forEach(b => b.classList.replace('border-indigo-500', 'border-transparent'));
    btn.classList.replace('border-transparent', 'border-indigo-500');
  }

  function setupPreview() {
    const fileIn = document.getElementById('main-file-input-final');
    const preview = document.getElementById('image-preview');
    const placeholder = document.getElementById('placeholder');
    const textIn = document.getElementById('input-text');
    const overlay = document.getElementById('overlay-preview');

    if (fileIn) {
      fileIn.addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = function(event) {
            preview.src = event.target.result;
            preview.classList.remove('hidden');
            if(placeholder) placeholder.classList.add('hidden');
            setTimeout(applyAll, 50);
          };
          reader.readAsDataURL(file);
        }
      });
    }

    if (textIn && overlay) {
      textIn.addEventListener('input', function() {
        overlay.innerText = textIn.value;
        const charCount = document.getElementById('char-count');
        if (charCount) charCount.innerText = textIn.value.length + " / 300";
      });
    }
  }

  document.addEventListener("turbo:load", setupPreview);
  document.addEventListener("DOMContentLoaded", setupPreview);
</script>
<% end %>